  <Folder>
    <name>TURNO 2 · 10-14hs</name>
    <Placemark>
      <name>Dupla D — Frontera — Polígono 2 (Recoleta)</name>
      <description>Tipo: frontera | Zona redefinida (2/10/2026), ver nota de A. D cubre el Polígono 2, sola en su turno (T2).</description>
